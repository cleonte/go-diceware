class GoDiceware < Formula
  desc "Diceware passphrase generator with English and Romanian wordlists"
  homepage "https://github.com/cleonte/go-diceware"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/cleonte/go-diceware/releases/download/v@VERSION@/diceware_@VERSION@_darwin_arm64.tar.gz"
      sha256 "@SHA_darwin_arm64@"
    end
    on_intel do
      url "https://github.com/cleonte/go-diceware/releases/download/v@VERSION@/diceware_@VERSION@_darwin_amd64.tar.gz"
      sha256 "@SHA_darwin_amd64@"
    end
  end
  on_linux do
    on_arm do
      url "https://github.com/cleonte/go-diceware/releases/download/v@VERSION@/diceware_@VERSION@_linux_arm64.tar.gz"
      sha256 "@SHA_linux_arm64@"
    end
    on_intel do
      url "https://github.com/cleonte/go-diceware/releases/download/v@VERSION@/diceware_@VERSION@_linux_amd64.tar.gz"
      sha256 "@SHA_linux_amd64@"
    end
  end

  def install
    bin.install "diceware"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/diceware --version")
    assert_match "Entropy", shell_output("#{bin}/diceware -w 1")
  end
end
